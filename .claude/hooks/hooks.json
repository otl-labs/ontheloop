{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bin/venv-python .claude/hooks/plugin_hooks.py check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bash .claude/hooks/session_start_aws.sh"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bash .claude/hooks/session_start_github_readiness.sh"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bash .claude/hooks/session_start_sync_deps.sh"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bash .claude/hooks/session_start_precommit.sh"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bash .claude/hooks/session_start_sync_main.sh"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bash .claude/hooks/session_start_deepen_history.sh"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bin/venv-python .claude/hooks/session_start_commit_signing.py"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bash .claude/hooks/session_start_terraform_assets.sh",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start_log_turn.sh\" --project-ref=ontheloop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bin/venv-python .claude/hooks/never_on_main.py"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bin/venv-python .claude/hooks/fresh_branch_base.py"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bin/venv-python .claude/hooks/edit_scope_guard.py"
          },
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bin/venv-python .claude/hooks/scheduled_agent_log_only.py"
          }
        ]
      },
      {
        "matcher": "^(Bash|Monitor|mcp__github(-full)?__(create_pull_request|push_files|create_or_update_file|delete_file))$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff_evidence_gate.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || \"$CLAUDE_PROJECT_DIR/bin/venv-python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_log_turn.py\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || \"$CLAUDE_PROJECT_DIR/bin/venv-python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_log_turn.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || \"$CLAUDE_PROJECT_DIR/bin/venv-python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_end_log_turn.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${ONTHELOOP_PROJECT_SETTINGS:-}\" ] || ! grep -qs '\"name\": \"ontheloop\"' \"$CLAUDE_PROJECT_DIR/.claude/.claude-plugin/plugin.json\" || \"$CLAUDE_PROJECT_DIR/bin/venv-python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_log_turn.py\""
          }
        ]
      }
    ]
  }
}
