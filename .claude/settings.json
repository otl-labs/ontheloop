{
  "model": "opus[1m]",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "ONTHELOOP_PROJECT_SETTINGS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git worktree:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(bin/venv-python:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",
      "mcp__github__pull_request_read",
      "mcp__github__update_pull_request_branch"
    ],
    "ask": [],
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "mcp__Claude_Docs",
      "mcp__claude-code-remote__create_environment",
      "mcp__claude-code-remote__update_environment",
      "mcp__claude-code-remote__get_environment",
      "mcp__claude-code-remote__switch_environment",
      "mcp__claude-code-remote__request_credential",
      "mcp__claude-code-remote__list_computer_folders",
      "mcp__claude-code-remote__request_computer_folder"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bin/venv-python .claude/statusline.py"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start_aws.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start_github_readiness.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start_sync_deps.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start_precommit.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start_sync_main.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start_deepen_history.sh"
          },
          {
            "type": "command",
            "command": "bin/venv-python .claude/hooks/session_start_commit_signing.py"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start_terraform_assets.sh",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start_log_turn.sh\" --project-ref=ontheloop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bin/venv-python .claude/hooks/never_on_main.py"
          },
          {
            "type": "command",
            "command": "bin/venv-python .claude/hooks/fresh_branch_base.py"
          },
          {
            "type": "command",
            "command": "bin/venv-python .claude/hooks/edit_scope_guard.py"
          },
          {
            "type": "command",
            "command": "bin/venv-python .claude/hooks/scheduled_agent_log_only.py"
          }
        ]
      },
      {
        "matcher": "^(Bash|Monitor|mcp__github(-full)?__(create_pull_request|push_files|create_or_update_file|delete_file))$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff_evidence_gate.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/venv-python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_log_turn.py\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/venv-python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_log_turn.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/venv-python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_end_log_turn.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/venv-python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_log_turn.py\""
          }
        ]
      }
    ]
  }
}
