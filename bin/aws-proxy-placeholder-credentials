#!/usr/bin/env bash
# credential_process target for cloud sessions: prints fixed placeholder credentials. The agent proxy holds the real
# agent_static key as an AWS network secret and re-signs STS calls, so nothing here is a usable key. No Expiration
# (static, no refresh loop) and no SessionToken (a fake token adds a header that could break the proxy re-sign).
set -euo pipefail
printf '{"Version": 1, "AccessKeyId": "%s", "SecretAccessKey": "%s"}\n' "proxy-injected-key-id" "proxy-injected-secret"
