{
  "schema_version": 1,
  "validate_policy_block": {
    "session": [
      "ERROR",
      "SECURITY_WARNING"
    ],
    "ci_writable": [
      "ERROR",
      "SECURITY_WARNING"
    ],
    "other": [
      "ERROR"
    ],
    "boundary": [
      "ERROR"
    ]
  },
  "ceilings": [
    "agent-platform-github-ci-apply-boundary"
  ],
  "classes": [
    {
      "id": "session",
      "role_names": [],
      "policy_names": [
        "agent-platform-session-*"
      ],
      "user_names": [
        "agent-platform-session"
      ],
      "never": [
        {
          "id": "iam_write",
          "actions": [
            "iam:Create*",
            "iam:Update*",
            "iam:Put*",
            "iam:Attach*",
            "iam:Detach*",
            "iam:Delete*",
            "iam:Add*",
            "iam:Remove*",
            "iam:Tag*",
            "iam:Untag*",
            "iam:Set*",
            "iam:Upload*",
            "iam:Enable*",
            "iam:Deactivate*",
            "iam:Change*",
            "iam:Reset*",
            "iam:PassRole"
          ]
        },
        {
          "id": "credential_minting",
          "actions": [
            "sts:AssumeRole*",
            "sts:AssumeRoot",
            "sts:GetFederationToken"
          ]
        },
        {
          "id": "secret_values_secretsmanager",
          "actions": [
            "secretsmanager:GetSecretValue",
            "secretsmanager:BatchGetSecretValue",
            "secretsmanager:PutSecretValue",
            "secretsmanager:UpdateSecret"
          ]
        },
        {
          "id": "secret_values_ssm",
          "actions": [
            "ssm:GetParameter",
            "ssm:GetParameters",
            "ssm:GetParametersByPath",
            "ssm:GetParameterHistory",
            "ssm:PutParameter"
          ],
          "resources": [
            "arn:aws:ssm:{region}:{account}:parameter/secret/*"
          ]
        },
        {
          "id": "s3_objects",
          "actions": [
            "s3:GetObject*",
            "s3:PutObject*",
            "s3:DeleteObject*",
            "s3:ListBucket"
          ]
        },
        {
          "id": "lambda_direct",
          "actions": [
            "lambda:InvokeFunction",
            "lambda:InvokeFunctionUrl",
            "lambda:GetFunction",
            "lambda:GetFunctionConfiguration"
          ]
        },
        {
          "id": "kms_decrypt",
          "actions": [
            "kms:Decrypt"
          ]
        }
      ]
    },
    {
      "id": "ci_writable",
      "role_names": [
        "agent-platform-*"
      ],
      "policy_names": [
        "agent-platform-*"
      ],
      "user_names": [],
      "never": [
        {
          "id": "protected_role_write",
          "actions": [
            "iam:PutRolePolicy",
            "iam:AttachRolePolicy",
            "iam:DeleteRolePolicy",
            "iam:DetachRolePolicy",
            "iam:UpdateAssumeRolePolicy",
            "iam:DeleteRole",
            "iam:PutRolePermissionsBoundary",
            "iam:DeleteRolePermissionsBoundary",
            "iam:PassRole"
          ],
          "resources": [
            "arn:aws:iam::{account}:role/PlatformAdmin",
            "arn:aws:iam::{account}:role/PlatformDev",
            "arn:aws:iam::{account}:role/bootstrap-*",
            "arn:aws:iam::{account}:role/github-settings-*",
            "arn:aws:iam::{account}:role/platform-security-*",
            "arn:aws:iam::{account}:role/ducklake-api-*"
          ]
        },
        {
          "id": "protected_policy_write",
          "actions": [
            "iam:CreatePolicyVersion",
            "iam:DeletePolicyVersion",
            "iam:SetDefaultPolicyVersion",
            "iam:DeletePolicy"
          ],
          "resources": [
            "arn:aws:iam::{account}:policy/agent-platform-github-ci-apply-boundary",
            "arn:aws:iam::{account}:policy/agent-platform-session-*",
            "arn:aws:iam::{account}:policy/bootstrap-*",
            "arn:aws:iam::{account}:policy/platform-security-*"
          ]
        },
        {
          "id": "user_write",
          "actions": [
            "iam:CreateUser",
            "iam:CreateAccessKey",
            "iam:PutUserPolicy",
            "iam:AttachUserPolicy",
            "iam:PutUserPermissionsBoundary",
            "iam:DeleteUserPermissionsBoundary",
            "iam:AddUserToGroup",
            "iam:CreateLoginProfile"
          ]
        },
        {
          "id": "credential_minting",
          "actions": [
            "sts:AssumeRoot",
            "sts:GetFederationToken"
          ]
        },
        {
          "id": "github_settings_key",
          "actions": [
            "secretsmanager:GetSecretValue",
            "secretsmanager:PutSecretValue"
          ],
          "resources": [
            "arn:aws:secretsmanager:{region}:{account}:secret:agent-platform-terraform-github-apply-app*"
          ]
        },
        {
          "id": "bootstrap_state_write",
          "actions": [
            "s3:PutObject",
            "s3:DeleteObject"
          ],
          "resources": [
            "arn:aws:s3:::agent-platform-bootstrap-tfstate/*"
          ]
        }
      ]
    }
  ]
}
