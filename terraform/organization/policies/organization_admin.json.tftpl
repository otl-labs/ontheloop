{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "OrgRead", "Effect": "Allow", "Action": ["organizations:Describe*", "organizations:List*"], "Resource": "*"},
    {"Sid": "OrgManage", "Effect": "Allow", "Action": ["organizations:CreateOrganization", "organizations:EnablePolicyType", "organizations:CreateOrganizationalUnit", "organizations:UpdateOrganizationalUnit", "organizations:CreatePolicy", "organizations:UpdatePolicy", "organizations:AttachPolicy", "organizations:DetachPolicy", "organizations:TagResource", "organizations:UntagResource"], "Resource": "*"},
    {"Sid": "OrgTrustedAccessIam", "Effect": "Allow", "Action": "organizations:EnableAWSServiceAccess", "Resource": "*", "Condition": {"StringEquals": {"organizations:ServicePrincipal": "iam.amazonaws.com"}}},
    {"Sid": "OrgServiceLinkedRole", "Effect": "Allow", "Action": "iam:CreateServiceLinkedRole", "Resource": "*", "Condition": {"StringEquals": {"iam:AWSServiceName": "organizations.amazonaws.com"}}},
    {"Sid": "RootFeatures", "Effect": "Allow", "Action": ["iam:EnableOrganizationsRootCredentialsManagement", "iam:EnableOrganizationsRootSessions", "iam:ListOrganizationsFeatures", "iam:GetAccountSummary"], "Resource": "*"},
    {"Sid": "OrgSecurityTrailManage", "Effect": "Allow", "Action": ["cloudtrail:CreateTrail", "cloudtrail:UpdateTrail", "cloudtrail:PutEventSelectors", "cloudtrail:StartLogging", "cloudtrail:AddTags", "cloudtrail:RemoveTags"], "Resource": "arn:aws:cloudtrail:${region}:${account_id}:trail/agent-platform-org-security-trail"},
    {"Sid": "OrgSecurityTrailRead", "Effect": "Allow", "Action": ["cloudtrail:GetTrail", "cloudtrail:GetTrailStatus", "cloudtrail:DescribeTrails", "cloudtrail:GetEventSelectors", "cloudtrail:GetInsightSelectors", "cloudtrail:ListTags"], "Resource": "*"},
    {"Sid": "CloudShellUse", "Effect": "Allow", "Action": ["cloudshell:CreateEnvironment", "cloudshell:CreateSession", "cloudshell:GetEnvironmentStatus", "cloudshell:StartEnvironment", "cloudshell:StopEnvironment", "cloudshell:PutCredentials", "cloudshell:DescribeEnvironments"], "Resource": "*"},
    {"Sid": "BucketManage", "Effect": "Allow", "Action": ["s3:CreateBucket", "s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketAcl", "s3:GetBucketVersioning", "s3:PutBucketVersioning", "s3:GetEncryptionConfiguration", "s3:PutEncryptionConfiguration", "s3:GetBucketPublicAccessBlock", "s3:PutBucketPublicAccessBlock", "s3:GetBucketPolicy", "s3:PutBucketPolicy", "s3:GetBucketTagging", "s3:PutBucketTagging", "s3:GetLifecycleConfiguration", "s3:PutLifecycleConfiguration", "s3:GetBucketOwnershipControls", "s3:PutBucketOwnershipControls", "s3:GetAccelerateConfiguration", "s3:GetBucketRequestPayment", "s3:GetBucketLogging", "s3:GetReplicationConfiguration", "s3:GetBucketObjectLockConfiguration", "s3:GetBucketCORS", "s3:GetBucketWebsite"], "Resource": ["arn:aws:s3:::agent-platform-organization-tfstate", "arn:aws:s3:::agent-platform-org-security-trail-${account_id}-${region}"]},
    {"Sid": "StateObjects", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"], "Resource": ["arn:aws:s3:::agent-platform-organization-tfstate/terraform.tfstate", "arn:aws:s3:::agent-platform-organization-tfstate/terraform.tfstate.tflock"]},
    {"Sid": "LogGroupManage", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:PutRetentionPolicy", "logs:TagResource", "logs:TagLogGroup", "logs:ListTagsForResource", "logs:ListTagsLogGroup", "logs:PutMetricFilter"], "Resource": "arn:aws:logs:${region}:${account_id}:log-group:agent-platform-org-security-*"},
    {"Sid": "LogsRead", "Effect": "Allow", "Action": ["logs:DescribeLogGroups", "logs:DescribeMetricFilters", "logs:TestMetricFilter"], "Resource": "*"},
    {"Sid": "AlarmManage", "Effect": "Allow", "Action": ["cloudwatch:PutMetricAlarm", "cloudwatch:TagResource", "cloudwatch:ListTagsForResource"], "Resource": "arn:aws:cloudwatch:${region}:${account_id}:alarm:agent-platform-org-security-*"},
    {"Sid": "AlarmRead", "Effect": "Allow", "Action": ["cloudwatch:DescribeAlarms", "cloudwatch:GetMetricStatistics"], "Resource": "*"},
    {"Sid": "TopicManage", "Effect": "Allow", "Action": ["sns:CreateTopic", "sns:SetTopicAttributes", "sns:GetTopicAttributes", "sns:TagResource", "sns:ListTagsForResource", "sns:Subscribe", "sns:ListSubscriptionsByTopic"], "Resource": "arn:aws:sns:${region}:${account_id}:agent-platform-org-security-alerts"},
    {"Sid": "TopicSubscriptionRead", "Effect": "Allow", "Action": ["sns:ListTopics", "sns:GetSubscriptionAttributes"], "Resource": "*"},
    {"Sid": "DeliveryRole", "Effect": "Allow", "Action": ["iam:CreateRole", "iam:GetRole", "iam:TagRole", "iam:ListRoleTags", "iam:PutRolePolicy", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies"], "Resource": "arn:aws:iam::${account_id}:role/agent-platform-org-security-*"},
    {"Sid": "DeliveryRolePass", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::${account_id}:role/agent-platform-org-security-*", "Condition": {"StringEquals": {"iam:PassedToService": "cloudtrail.amazonaws.com"}}},
    {"Sid": "SelfUser", "Effect": "Allow", "Action": ["iam:GetUser", "iam:TagUser", "iam:ListUserTags", "iam:GetUserPolicy", "iam:ListUserPolicies", "iam:ListAttachedUserPolicies", "iam:PutUserPolicy"], "Resource": "arn:aws:iam::${account_id}:user/org-admin-operator"},
    {"Sid": "SelfRole", "Effect": "Allow", "Action": ["iam:GetRole", "iam:TagRole", "iam:ListRoleTags", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:PutRolePolicy"], "Resource": "arn:aws:iam::${account_id}:role/OrganizationAdmin"},
    {"Sid": "TfvarsRead", "Effect": "Allow", "Action": "ssm:GetParameter", "Resource": "arn:aws:ssm:${region}:${account_id}:parameter/secret/agent-platform-terraform-organization-tfvars"}
  ]
}
