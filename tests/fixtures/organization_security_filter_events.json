      "must_match": [
        "agent-platform-org-security-admin-role-assumed"
      ],
      "event": {
        "eventSource": "signin.amazonaws.com",
        "eventName": "SwitchRole",
        "userIdentity": {
          "type": "IAMUser",
          "arn": "arn:aws:iam::ACCOUNT:user/org-admin-operator",
          "accountId": "ACCOUNT",
          "userName": "org-admin-operator"
        },
        "readOnly": false,
        "eventType": "AwsConsoleSignIn",
        "additionalEventData": {
          "SwitchFrom": "arn:aws:iam::ACCOUNT:user/org-admin-operator",
          "SwitchTo": "arn:aws:iam::ACCOUNT:role/OrganizationAdmin"
        },
        "responseElements": {
          "SwitchRole": "Success"
        }
      }
    },
