{
  "input": {
    "type": "object",
    "additionalProperties": false,
    "required": ["change_id", "head_sha", "plan", "marker"],
    "properties": {
      "change_id": {"type": "string", "minLength": 1},
      "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "plan": {"type": "string"},
      "marker": {"type": "string"}
    }
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": ["outcome"],
    "properties": {
      "outcome": {"type": "string", "enum": ["success", "failure"]},
      "verdict": {"type": "string", "enum": ["PROCEED", "REVISE", "BLOCK", "FLAGS_FOUND"]},
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "blocking"],
          "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "blocking": {"type": "boolean"}}
        }
      },
      "failure": {"type": "string", "enum": ["budget_exhausted", "schema_invalid", "input_incomplete", "injection_suspected", "input_unusable"]},
      "detail": {"type": "string"}
    }
  }
}
